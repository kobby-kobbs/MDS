# ── Azure Resources (shared defaults) ─────────────────────────────
# Shared Azure ML Registry name (used when customer has no dedicated registry)
REGISTRY_NAME=fl_private_model

# Shared Azure Blob Storage (used when customer has no dedicated storage)
STORAGE_ACCOUNT=customermodelstorage
STORAGE_CONTAINER=models

# ── MDS Service Configuration ────────────────────────────────────
# Admin key for /admin/* endpoints (register, offboard, refresh-jwks)
MDS_ADMIN_KEY=

# App name used to build catalog URLs in registration responses
# MDS_APP_NAME=mds-model-distribution

# Explicit path to customers.json (auto-detected if not set)
# MDS_CUSTOMERS_FILE=

# Disable rate limiting for testing (set to true, 1, or yes)
# MDS_DISABLE_RATE_LIMIT=false

# ── Customer Auth Configuration ──────────────────────────────
# Override default issuer/JWKS URLs per customer via env vars.
# Format: CUSTOMER_<ID>_ISSUER, CUSTOMER_<ID>_JWKS_URL
#
# CUSTOMER_PHONEPE_ISSUER=https://auth.phonepe.com
# CUSTOMER_PHONEPE_JWKS_URL=https://auth.phonepe.com/.well-known/jwks.json
#
# CUSTOMER_ACME_ISSUER=https://auth.acme.com
# CUSTOMER_ACME_JWKS_URL=https://auth.acme.com/.well-known/jwks.json

# ── Per-Customer Registry & Storage ──────────────────────────
# When a customer is onboarded, they get their own registry + storage.
# Created by: infrastructure/onboard.ps1
#
# CUSTOMER_PHONEPE_REGISTRY=mds-phonepe-registry
# CUSTOMER_PHONEPE_STORAGE=mdsphonepestore
#
# CUSTOMER_ACME_REGISTRY=mds-acme-registry
# CUSTOMER_ACME_STORAGE=mdsacmestore
